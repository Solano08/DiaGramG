# Copia este archivo a .env.local para desarrollo.
# En Vercel: Project Settings → Environment Variables
# (márcala en Production, Preview y Development).

# https://vercel.com/ai-gateway
# En el deployment de Vercel también puede usarse el token OIDC automático
# (VERCEL_OIDC_TOKEN). La clave sigue siendo necesaria en local.
AI_GATEWAY_API_KEY=
